# Copie ce fichier en ".env" et remplis les valeurs.
# (Ne commite JAMAIS le fichier .env : il contient tes secrets.)

# --- HubSpot ---
# Token d'application privee HubSpot, avec les scopes CMS Pages en lecture + ecriture.
# HubSpot > Parametres > Integrations > Applications privees > Creer une application privee
# Scopes requis : content (lecture + ecriture des pages CMS)
HUBSPOT_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optionnel ---
# Modele Claude a utiliser (defaut : claude-opus-4-8).
CLAUDE_MODEL=claude-opus-4-8
